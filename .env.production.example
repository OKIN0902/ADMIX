APP_NAME=ADMIX
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:REPLACE_WITH_A_REAL_KEY
APP_URL=https://your-domain.example

# Use long, unique passwords. Do not reuse your XAMPP credentials.
ADMIX_DB_NAME=admix
ADMIX_DB_USER=admix_app
ADMIX_DB_PASSWORD=replace-with-a-long-random-password
ADMIX_DB_ROOT_PASSWORD=replace-with-a-different-long-random-password

# Optional HTTP port when running behind a host-level reverse proxy.
HTTP_PORT=80
